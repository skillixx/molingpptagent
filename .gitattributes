*.sh text eol=lf

# 城市模板的构建产物保持 LF，确保 Windows 克隆后也能按字节复核确定性输出。
backend/main_api/template/template_24.json text eol=lf
backend/main_api/template/template_25.json text eol=lf
backend/main_api/template/template_26.json text eol=lf
backend/main_api/template/template_29.json text eol=lf

# 音乐模板证据按原始字节计算摘要，禁止 Git 转换这些快照的行尾。
doc/assets/template_29_qa/*.json -text whitespace=cr-at-eol
doc/assets/template_29_qa/editor-verified/*.json -text whitespace=cr-at-eol
doc/assets/template_29_qa/runtime/*.json -text whitespace=cr-at-eol
